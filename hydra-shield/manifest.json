{
  "manifest_version": 3,
  "name": "Hydra TV Shield - Anti-Popups & Ad Defuser",
  "version": "1.0",
  "description": "Bloquea y absorbe ventanas emergentes, redirecciones y anuncios en reproductores de streaming para Hydra TV.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
