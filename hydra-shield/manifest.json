{
  "manifest_version": 3,
  "name": "Hydra TV Shield - Anti-Popups & Cloudflare Turnstile Solver",
  "version": "1.1",
  "description": "Bloquea anuncios, ventanas emergentes y resuelve verificaciones de Cloudflare Turnstile en sitios de streaming para Hydra TV.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.cloudflare.com/*"
      ],
      "js": ["turnstile.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
